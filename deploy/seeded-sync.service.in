[Unit]
Description=seeded.art token and marketplace update
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=seeded
Group=seeded
WorkingDirectory=/var/lib/seeded
EnvironmentFile=/etc/seeded/seeded.env
# Clear a trade's sync request first: one written during this run starts the next run.
ExecStartPre=/usr/bin/rm -f /var/lib/seeded/sync.request
ExecStart=/usr/bin/python3 /opt/seeded/current/deploy/maintain.py sync
Restart=no
# 75: writer busy or budget reached; the next run 10 minutes later resumes.
SuccessExitStatus=75
TimeoutStartSec=9min
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
StateDirectory=seeded
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryAccounting=true
MemoryMax=__JOB_MEMORY_MAX__
CPUQuota=__JOB_CPU_QUOTA__
TasksMax=__JOB_TASKS_MAX__
LimitNOFILE=__APP_OPEN_FILES__
StandardOutput=journal
StandardError=journal
