[Unit]
Description=Private forum database backup with seven-copy retention
After=mariadb.service
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
User=seeded-forum-backup
Group=seeded-forum-backup
StateDirectory=seeded-forum-backup
StateDirectoryMode=0700
WorkingDirectory=/var/lib/seeded-forum-backup
ExecStart=/usr/bin/python3 /opt/seeded/current/deploy/forum_backup.py
Restart=on-failure
RestartPreventExitStatus=1 64 130
RestartSec=5min
TimeoutStartSec=11min
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryAccounting=true
MemoryMax=256M
CPUQuota=50%
TasksMax=16
LimitNOFILE=64
StandardOutput=journal
StandardError=journal
