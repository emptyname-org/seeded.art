[Unit]
Description=seeded.art checked online backup with two-copy retention
After=seeded-profiles.service seeded-verify.service
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
User=seeded
Group=seeded
WorkingDirectory=/var/lib/seeded
EnvironmentFile=/etc/seeded/seeded.env
ExecStart=/usr/bin/python3 /opt/seeded/current/deploy/maintain.py backup
Restart=on-failure
RestartPreventExitStatus=1 64 130
RestartSec=5min
TimeoutStartSec=42min
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
StateDirectory=seeded
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryAccounting=true
MemoryMax=__JOB_MEMORY_MAX__
CPUQuota=__JOB_CPU_QUOTA__
TasksMax=__JOB_TASKS_MAX__
LimitNOFILE=__APP_OPEN_FILES__
StandardOutput=journal
StandardError=journal
