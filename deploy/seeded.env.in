SEEDED_BIND=127.0.0.1:3918
SEEDED_CONTENT_BIND=127.0.0.1:3919
SEEDED_TRUST_LOOPBACK_PROXY=true
SEEDED_APP_ORIGIN=https://__APP_HOST__
SEEDED_CONTENT_ORIGIN=https://__CONTENT_HOST__
SEEDED_DATABASE=/var/lib/seeded/archive.sqlite
SEEDED_SALES_DATABASE=/var/lib/seeded/sales.sqlite
SEEDED_ARTICLES_DATABASE=/var/lib/seeded/articles.sqlite
SEEDED_TRADING_DATABASE=/var/lib/seeded/trading.sqlite
SEEDED_TRADING_RPC=https://prod.tcinfra.net/rpc/mainnet
SEEDED_TRADING_TZKT=https://api.tzkt.io/v1
SEEDED_PLATFORM_FEE_BPS=250
SEEDED_PLATFORM_FEE_ADDRESS=__PLATFORM_FEE_ADDRESS__
SEEDED_CACHE=/var/lib/seeded/cache
SEEDED_MIRROR=__MIRROR__
SEEDED_MIRROR_BYTES=__MIRROR_BYTES__
SEEDED_CONTENT_CONCURRENCY=__CONTENT_CONCURRENCY__
SEEDED_MAX_OBJECT_BYTES=__MAX_OBJECT_BYTES__
SEEDED_ASSETS=/opt/seeded/current/assets
TMPDIR=/var/lib/seeded/tmp
__OAUTH_ENVIRONMENT__
